# Copiar a deploy/.env.production y completar — NUNCA commitear el archivo real
DOMAIN=yapai.com

POSTGRES_USER=yapai
POSTGRES_PASSWORD=cambiar-password-segura
POSTGRES_DB=yapai_db

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Orígenes exactos de los frontends (sin wildcard en producción)
CORS_ORIGINS=https://app.yapai.com,https://admin.yapai.com

# "auto" activa signups al instante · "manual" requiere aprobación admin
SIGNUP_MODE=auto

# Sentry (opcional pero recomendado): DSN del proyecto backend
SENTRY_DSN=

# SMTP transaccional (onboarding, recuperación, bienvenida)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yapai.com
