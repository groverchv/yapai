# Reverse proxy YAPAI — TLS automático (Let's Encrypt)
# Definir DOMAIN en el entorno del contenedor caddy (ej. yapai.com)
#
# Superficies:
#   yapai.com / www  → PWA cliente (producto principal)
#   app.yapai.com    → portal socio
#   admin.yapai.com  → portal admin
#   api.yapai.com    → API FastAPI

# Headers de seguridad para los frontends (la API los envía desde su middleware).
# img-src incluye https: — las fotos vienen de Cloudinary/Unsplash.
(headers_seguridad) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.{$DOMAIN}; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'"
	}
}

api.{$DOMAIN} {
	reverse_proxy api:8000
	# /metrics solo accesible internamente (Prometheus), no público
	@metrics path /metrics
	respond @metrics 404
}

# PWA cliente — dominio principal
{$DOMAIN} {
	import headers_seguridad
	reverse_proxy cliente:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

app.{$DOMAIN} {
	import headers_seguridad
	reverse_proxy socio:3000
}

admin.{$DOMAIN} {
	import headers_seguridad
	reverse_proxy admin:3000
}
