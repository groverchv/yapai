PROJECT_NAME=Yapai API
ENV=development
PORT=8000
DEBUG=True

# Conexión directa a PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yapai_db

# Override de conexión (ej. sqlite:///./yapai_dev.db para dev sin Docker). Vacío = usa POSTGRES_*
DATABASE_URL=

# PostgREST URL (si se usa la capa REST de PostgREST)
POSTGREST_URL=http://localhost:3000

# JWT — OBLIGATORIO cambiar en producción
JWT_SECRET=cambiar-por-secreto-largo-aleatorio
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ONBOARDING_TOKEN_HOURS=72
RESET_TOKEN_HOURS=2

# Email SMTP
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yapai.com
SMTP_TLS=true

# Frontends (para links de emails)
FRONTEND_ADMIN_URL=http://localhost:5173
FRONTEND_SOCIO_URL=http://localhost:5174

# CORS: orígenes permitidos separados por coma. En producción: dominios reales (nunca *)
CORS_ORIGINS=*

# Semilla
SEED_ADMIN_EMAIL=admin@yapai.com
SEED_ADMIN_PASSWORD=Admin123!

# --- SaaS ---
# Modo de registro público de socios: "auto" (activo al instante) o "manual" (requiere aprobación admin)
SIGNUP_MODE=auto
# Días de prueba para cuentas nuevas por signup
TRIAL_DIAS=14
# Billing: día de vencimiento de la factura mensual del plan y días de gracia
# antes de suspender automáticamente al socio por impago
FACTURA_VENCE_DIA=10
FACTURA_GRACIA_DIAS=7
# Jobs en background (expiración de pases + facturación). false solo en tests
JOBS_ENABLED=true

# --- Observabilidad ---
# DSN de Sentry (vacío = desactivado)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE=0.1
# Access log en JSON (true en producción)
LOG_JSON=false

# --- Seguridad / escalado ---
# Redis para rate limiting distribuido (multi-worker). Vacío = en memoria (1 instancia)
# REDIS_URL=redis://localhost:6379/0

# --- Web Push (notificaciones al cliente) ---
# Generar par VAPID: py-vapid --gen (o cryptography EC P-256, claves en base64url)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@yapai.com
