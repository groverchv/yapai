PROJECT_NAME=Yapai API
ENV=development
PORT=8000
DEBUG=True

# Conexión directa a PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yapai_db

# Override de conexión (ej. sqlite:///./yapai_dev.db para dev sin Docker). Vacío = usa POSTGRES_*
DATABASE_URL=

# JWT — OBLIGATORIO cambiar en producción (>=32 chars aleatorios)
JWT_SECRET=cambiar-por-secreto-largo-aleatorio-de-32-chars-minimo
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ONBOARDING_TOKEN_HOURS=72
RESET_TOKEN_HOURS=2

# Email SMTP
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yapai.com
SMTP_TLS=true

# Frontends (para links de emails)
FRONTEND_ADMIN_URL=http://localhost:5173
FRONTEND_SOCIO_URL=http://localhost:5174
FRONTEND_CLIENTE_URL=http://localhost:5176

# CORS: orígenes permitidos separados por coma. En producción: dominios reales (nunca *)
CORS_ORIGINS=*

# Documentación OpenAPI (/docs, /openapi.json). Vacío = visible solo fuera de producción
# DOCS_ENABLED=false

# IPs de proxies de confianza para X-Forwarded-For (coma-separadas; "*" solo si el
# puerto de la app jamás se publica fuera de la red docker)
TRUSTED_PROXIES=127.0.0.1

# Semilla
SEED_ADMIN_EMAIL=admin@yapai.com
SEED_ADMIN_PASSWORD=Admin123!
# Datos demo (tenant, owner, cajero, cliente, kiosco de prueba). PROHIBIDO en producción
SEED_DEMO=true
# Kiosco demo público sin PIN (landing "Probar demo"): device_token de una
# pantalla de un tenant exclusivo para demo. Vacío = deshabilitado.
DEMO_DEVICE_TOKEN=

# --- SaaS ---
# Modo de registro público de socios: "auto" (activo al instante) o "manual" (requiere aprobación admin)
SIGNUP_MODE=auto
# Días de prueba para cuentas nuevas por signup
TRIAL_DIAS=14
# Billing: día de vencimiento de la factura mensual del plan y días de gracia
# antes de suspender automáticamente al socio por impago
FACTURA_VENCE_DIA=10
FACTURA_GRACIA_DIAS=7
# Jobs en background dentro de la API. En producción multi-instancia: false aquí
# y proceso separado `python -m app.jobs.runner` (servicio `jobs` del compose prod)
JOBS_ENABLED=true

# --- Observabilidad ---
# DSN de Sentry (vacío = desactivado)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE=0.1
# Access log en JSON (true en producción)
LOG_JSON=false

# --- Seguridad / escalado ---
# Redis para rate limiting distribuido (multi-worker). Vacío = en memoria (1 instancia)
# REDIS_URL=redis://localhost:6379/0

# --- Web Push (notificaciones al cliente) ---
# Generar par VAPID: py-vapid --gen (o cryptography EC P-256, claves en base64url)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@yapai.com

# --- Autenticación de clientes (OTP como 2do factor) ---
# OBLIGATORIO en producción: CLIENTE_OTP_ENABLED=true y OTP_PROVIDER=webhook
CLIENTE_OTP_ENABLED=true
OTP_TTL_MINUTES=5
OTP_MAX_INTENTOS=5
# "log" imprime el código en consola (SOLO desarrollo). "webhook" hace POST a
# OTP_WEBHOOK_URL con {telefono, codigo, ttl_minutos} — integra SMS/WhatsApp.
OTP_PROVIDER=log
# OTP_WEBHOOK_URL=https://api.tu-proveedor-sms.com/enviar
# OTP_WEBHOOK_TOKEN=token-bearer-opcional

# --- Transporte de tokens ---
# "bearer" (API/móvil), "cookie" (HttpOnly+SameSite, frontends web) o "both"
AUTH_TRANSPORT=both
# Dominio de cookie para compartir entre subdominios (ej: .yapai.com). Vacío = host-only
COOKIE_DOMAIN=

# --- Antifraude de emisión de puntos ---
# Alerta en audit_log + métrica Prometheus si se superan umbrales
FRAUDE_PUNTOS_EMISOR_HORA=50000
FRAUDE_PUNTOS_CLIENTE_DIA=20000

# --- Seguridad de administración ---
# 2FA obligatorio para superadmins. OBLIGATORIO en producción (fail-fast si false)
REQUIRE_SUPERADMIN_2FA=false

# --- Stripe (webhook con firma + suspensión por mora) ---
# POST /api/v1/billing/stripe/webhook — idempotente, verifica firma HMAC
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Cloudinary (subida de imágenes) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
